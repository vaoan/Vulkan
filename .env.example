# Copy to supabase/.env (ignored by git) and fill in. Never commit real values.

# Clerk as Supabase third-party auth: the Supabase CLI reads these as overrides of
# [auth.third_party.clerk] in supabase/config.toml. The domain is the Clerk instance's
# Frontend API host, from https://clerk.com/setup/supabase.
SUPABASE_AUTH_THIRD_PARTY_CLERK_ENABLED=false
SUPABASE_AUTH_THIRD_PARTY_CLERK_DOMAIN=your-instance.clerk.accounts.dev
